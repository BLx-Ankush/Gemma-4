# ─────────────────────────────────────────────────────────────────────────────
# AEGIS Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Local llama-server (required for offline mode) ────────────────────────────

# Path to the pre-compiled llama-server binary
# Termux default: ./models/llama-server
AEGIS_LLAMA_SERVER_BIN=./models/llama-server

# Path to the quantised Gemma model file
AEGIS_MODEL_PATH=./models/gemma4-e2b.gguf

# Path to the multimodal projector (enables image input)
# If this file is missing, AEGIS runs in text-only mode — that is fine.
AEGIS_MMPROJ_PATH=./models/mmproj-gemma4-e2b.gguf

# llama-server network settings
AEGIS_LOCAL_HOST=127.0.0.1
AEGIS_LOCAL_PORT=8080

# CPU threads for llama-server (leave blank to auto-detect via nproc)
# AEGIS_THREADS=4

# Context window size in tokens (4096 is safe for most budget phones)
AEGIS_CTX_SIZE=4096

# Max tokens for primary response generation.
# Lower this value for faster responses on CPU-only devices.
AEGIS_MAX_TOKENS=96

# Optional VEDA-specific cap for interactive requests.
# If unset, AEGIS uses a safe default tuned for responsiveness.
AEGIS_VEDA_MAX_TOKENS=32

# Local inference request timeout in seconds.
# Set higher on slower CPUs to avoid fallback due to read timeout.
AEGIS_LOCAL_TIMEOUT_SEC=35

# If primary generation exceeds this many milliseconds, MIRROR is deferred
# to avoid multi-minute end-to-end waits in the UI.
AEGIS_SYNC_MIRROR_MAX_MODEL_MS=12000

# Hard API request timeouts (seconds) to prevent indefinite "Processing..." waits.
AEGIS_REQUEST_TIMEOUT_SEC=65
AEGIS_VEDA_REQUEST_TIMEOUT_SEC=65
AEGIS_VOICE_REQUEST_TIMEOUT_SEC=65

# ── Flask server ──────────────────────────────────────────────────────────────

# Bind to 0.0.0.0 so devices on the hotspot can reach AEGIS
AEGIS_HOST=0.0.0.0
AEGIS_APP_PORT=5000

# ── Cloud inference (optional — AEGIS works fully offline without these) ──────
# When set, AEGIS automatically uses the cloud model when internet is available
# and falls back to the local llama-server when offline.

# Google Gemini/Gemma API endpoint
AEGIS_CLOUD_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-4-31b-it:generateContent

# Your Google AI Studio API key (get one free at aistudio.google.com)
AEGIS_CLOUD_API_KEY=Y5AgsP887nKJRVJ-VCAAjsqw5vXNVJWMzx6ihZuhhDYe7l9ylPuc6jl5ZAFc0ABs

# Label shown in status bar when cloud is active
AEGIS_CLOUD_MODEL_LABEL=gemma-4-31b-cloud

# Cloud request timeout in seconds. Increase if your internet is slow.
AEGIS_CLOUD_TIMEOUT_SEC=30

# 0 = fail fast on cloud timeout/error (avoid long local fallback delays while online)
# 1 = fallback to local model when cloud request fails
AEGIS_ONLINE_FALLBACK_TO_LOCAL=0

# ── Connectivity detection ────────────────────────────────────────────────────

# URL to HEAD-request for online/offline detection
AEGIS_CONNECTIVITY_URL=http://clients3.google.com/generate_204

# Seconds between connectivity re-checks (30 = one re-check per 30s max)
AEGIS_REFRESH_INTERVAL=30

# ── Drug lookup ───────────────────────────────────────────────────────────────

# Set to 0 to disable live OpenFDA lookups (uses local cache only)
AEGIS_ENABLE_LIVE_DRUG_API=1

# Text query TTS can add several seconds. Keep off for responsive VEDA UX.
AEGIS_ENABLE_TEXT_TTS=0

# Keep voice-turn TTS on for conversational mode.
AEGIS_ENABLE_VOICE_TTS=1

# Max characters passed to TTS engine.
AEGIS_TTS_MAX_CHARS=500
