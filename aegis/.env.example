# ─────────────────────────────────────────────────────────────────────────────
# AEGIS Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local llama-server ────────────────────────────────────────────────────────
AEGIS_LLAMA_SERVER_BIN=./models/llama-server
AEGIS_MODEL_PATH=./models/gemma4-e2b.gguf
AEGIS_MMPROJ_PATH=./models/mmproj-gemma4-e2b.gguf
AEGIS_LOCAL_HOST=127.0.0.1
AEGIS_LOCAL_PORT=8080
AEGIS_CTX_SIZE=4096
AEGIS_MAX_TOKENS=256
AEGIS_MAX_TOKENS_HARD_CAP=384
AEGIS_VEDA_MAX_TOKENS=192
AEGIS_MIRROR_MAX_TOKENS=192
AEGIS_MIRROR_MAX_TOKENS_OFFLINE=96
AEGIS_LOCAL_TIMEOUT_SEC=120

# Startup hardening (used by start.sh)
AEGIS_LLAMA_STARTUP_TIMEOUT_SEC=120
AEGIS_WARMUP_REQUEST_TIMEOUT_SEC=8
AEGIS_WATCHDOG_INTERVAL_SEC=8
AEGIS_LLAMA_PARALLEL=2
AEGIS_LOW_RAM_PARALLEL=1
AEGIS_ENABLE_MLOCK=1
AEGIS_DISABLE_MMAP=0

# ── Flask server timeouts ─────────────────────────────────────────────────────
AEGIS_REQUEST_TIMEOUT_SEC=120
AEGIS_VEDA_REQUEST_TIMEOUT_SEC=120
AEGIS_VOICE_REQUEST_TIMEOUT_SEC=120

# ── Flask server ──────────────────────────────────────────────────────────────
AEGIS_HOST=0.0.0.0
AEGIS_APP_PORT=5000

# ── Cloud inference ───────────────────────────────────────────────────────────
AEGIS_CLOUD_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-4-31b-it:generateContent
AEGIS_CLOUD_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY_HERE
AEGIS_CLOUD_MODEL_LABEL=gemma-4-31b-cloud
AEGIS_CLOUD_TIMEOUT_SEC=20
AEGIS_ONLINE_FALLBACK_TO_LOCAL=1
AEGIS_CLOUD_COOLDOWN_ENABLED=1
AEGIS_CLOUD_FAILURE_THRESHOLD=2
AEGIS_CLOUD_FAILURE_COOLDOWN_SEC=25

# ── Connectivity ──────────────────────────────────────────────────────────────
AEGIS_CONNECTIVITY_URL=http://clients3.google.com/generate_204
AEGIS_REFRESH_INTERVAL=15

# ── Features ──────────────────────────────────────────────────────────────────
AEGIS_ENABLE_LIVE_DRUG_API=1
AEGIS_OPENFDA_TIMEOUT_SEC=2
AEGIS_ENABLE_TEXT_TTS=1
AEGIS_ENABLE_VOICE_TTS=1

# TTS provider:
#   google_ai_studio = use Google AI Studio speech synthesis
#   local            = force local pyttsx3
#   auto             = try Google first then fallback local
AEGIS_TTS_PROVIDER=google_ai_studio

# Optional: separate key for TTS (defaults to AEGIS_CLOUD_API_KEY when empty)
AEGIS_GOOGLE_TTS_API_KEY=
AEGIS_GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
AEGIS_GOOGLE_TTS_VOICE=Kore
AEGIS_GOOGLE_TTS_TIMEOUT_SEC=35
AEGIS_GOOGLE_TTS_FALLBACK_LOCAL=0
AEGIS_ENABLE_RESPONSE_LANGUAGE_REWRITE=1
AEGIS_ENABLE_VOICE_LANGUAGE_REWRITE=0
AEGIS_LANGUAGE_REWRITE_MAX_PRIMARY_LATENCY_MS=18000
AEGIS_TTS_MAX_CHARS=500
