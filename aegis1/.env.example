# ─────────────────────────────────────────────────────────────────────────────
# AEGIS Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Local llama-server (required for offline mode) ────────────────────────────

# Path to the pre-compiled llama-server binary
# Termux default: ./models/llama-server
AEGIS_LLAMA_SERVER_BIN=./models/llama-server

# Path to the quantised Gemma model file
AEGIS_MODEL_PATH=./models/gemma4-e2b.gguf

# Path to the multimodal projector (enables image input)
# If this file is missing, AEGIS runs in text-only mode — that is fine.
AEGIS_MMPROJ_PATH=./models/mmproj-gemma4-e2b.gguf

# llama-server network settings
AEGIS_LOCAL_HOST=127.0.0.1
AEGIS_LOCAL_PORT=8080

# CPU threads for llama-server (leave blank to auto-detect via nproc)
# AEGIS_THREADS=4

# Context window size in tokens (4096 is safe for most budget phones)
AEGIS_CTX_SIZE=4096

# ── Flask server ──────────────────────────────────────────────────────────────

# Bind to 0.0.0.0 so devices on the hotspot can reach AEGIS
AEGIS_HOST=0.0.0.0
AEGIS_APP_PORT=5000

# ── Cloud inference (optional — AEGIS works fully offline without these) ──────
# When set, AEGIS automatically uses the cloud model when internet is available
# and falls back to the local llama-server when offline.

# Google Gemini/Gemma API endpoint
AEGIS_CLOUD_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-3-27b-it:generateContent

# Your Google AI Studio API key (get one free at aistudio.google.com)
AEGIS_CLOUD_API_KEY=

# Label shown in status bar when cloud is active
AEGIS_CLOUD_MODEL_LABEL=gemma-27b-cloud

# ── Connectivity detection ────────────────────────────────────────────────────

# URL to HEAD-request for online/offline detection
AEGIS_CONNECTIVITY_URL=http://clients3.google.com/generate_204

# Seconds between connectivity re-checks (30 = one re-check per 30s max)
AEGIS_REFRESH_INTERVAL=30

# ── Drug lookup ───────────────────────────────────────────────────────────────

# Set to 0 to disable live OpenFDA lookups (uses local cache only)
AEGIS_ENABLE_LIVE_DRUG_API=1
