# ─────────────────────────────────────────────────────────────────────────────
# AEGIS Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Local llama-server ────────────────────────────────────────────────────────
AEGIS_LLAMA_SERVER_BIN=./models/llama-server
AEGIS_MODEL_PATH=./models/gemma4-e2b.gguf
AEGIS_MMPROJ_PATH=./models/mmproj-gemma4-e2b.gguf
AEGIS_LOCAL_HOST=127.0.0.1
AEGIS_LOCAL_PORT=8080
AEGIS_CTX_SIZE=4096

# FIX: Raised from 96 to 256. Medical responses need at least 150 tokens.
AEGIS_MAX_TOKENS=256

# FIX: Raised from 32 to 256. 32 tokens = 3-4 words, not usable for medical guidance.
AEGIS_VEDA_MAX_TOKENS=256

# FIX: Raised from 35 to 90. CPU offline inference takes 77s+ and was timing out.
AEGIS_LOCAL_TIMEOUT_SEC=90

# ── Flask server timeouts ─────────────────────────────────────────────────────
# FIX: Raised from 65 to 150. Online: ~25s. Offline: VEDA ~77s + MIRROR ~20s = ~97s.
# 150s gives 50s of headroom so the UI never times out mid-response.
AEGIS_REQUEST_TIMEOUT_SEC=150
AEGIS_VEDA_REQUEST_TIMEOUT_SEC=150
AEGIS_VOICE_REQUEST_TIMEOUT_SEC=150

# ── Flask server ──────────────────────────────────────────────────────────────
AEGIS_HOST=0.0.0.0
AEGIS_APP_PORT=5000

# ── Cloud inference ───────────────────────────────────────────────────────────
AEGIS_CLOUD_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-4-31b-it:generateContent
# SECURITY: Set your actual API key here. Do not commit this file.
AEGIS_CLOUD_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY_HERE
AEGIS_CLOUD_MODEL_LABEL=gemma-4-31b-cloud
AEGIS_CLOUD_TIMEOUT_SEC=30

# FIX: Changed from 0 to 1. When cloud fails, fall back to local rather than crashing.
AEGIS_ONLINE_FALLBACK_TO_LOCAL=1

# ── Connectivity ──────────────────────────────────────────────────────────────
AEGIS_CONNECTIVITY_URL=http://clients3.google.com/generate_204
AEGIS_REFRESH_INTERVAL=30

# ── Features ──────────────────────────────────────────────────────────────────
AEGIS_ENABLE_LIVE_DRUG_API=1
AEGIS_ENABLE_TEXT_TTS=0
AEGIS_ENABLE_VOICE_TTS=1
AEGIS_TTS_MAX_CHARS=500
